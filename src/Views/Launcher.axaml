<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="using:SourceGit"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:c="using:SourceGit.Converters"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                    x:Class="SourceGit.Views.Launcher"
                    x:DataType="vm:Launcher"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{Binding Title}"
                    MinWidth="1024" MinHeight="600">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{Binding #ThisControl.CaptionHeight}"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Custom TitleBar -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,32,*,Auto,Auto,Auto">
      <!-- Background -->
      <Border Grid.Column="0" Grid.ColumnSpan="6"
              Background="{DynamicResource Brush.TitleBar}"
              DoubleTapped="MaximizeOrRestoreWindow"
              PointerPressed="BeginMoveWindow"/>

      <!-- Caption Buttons (macOS) -->
      <v:MacOSTrafficLightsSpacer Grid.Column="0"
                                  Zoom="{Binding Source={x:Static vm:Preferences.Instance}, Path=Zoom, Mode=OneWay}"
                                  IsFullScreen="{Binding #ThisControl.WindowState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.FullScreen}}"
                                  IsVisible="{OnPlatform False, macOS=True}"/>

      <!-- Menu (Windows/Linux) -->
      <Button Grid.Column="0" Classes="icon_button" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{OnPlatform True, macOS=False}">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft" VerticalOffset="-6">
            <MenuItem Header="{DynamicResource Text.Preferences}" Command="{x:Static s:App.OpenPreferencesCommand}" InputGesture="Ctrl+,">
              <MenuItem.Icon>
                <Path Width="14" Height="14" Data="{StaticResource Icons.Settings}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.Hotkeys}" Command="{x:Static s:App.OpenHotkeysCommand}" InputGesture="F1">
              <MenuItem.Icon>
                <Path Width="14" Height="14" Data="{StaticResource Icons.Hotkeys}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.SSHKeyHelper}" Command="{x:Static s:App.OpenSSHKeyHelperCommand}">
              <MenuItem.Icon>
                <Path Width="14" Height="14" Data="{StaticResource Icons.Tool}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.OpenAppDataDir}" Command="{x:Static s:App.OpenAppDataDirCommand}" IsVisible="{OnPlatform True, Linux=False}">
              <MenuItem.Icon>
                <Path Width="14" Height="14" Data="{StaticResource Icons.Explore}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.OpenAppDataDir}" IsVisible="{OnPlatform False, Linux=True}">
              <MenuItem.Icon>
                <Path Width="14" Height="14" Data="{StaticResource Icons.Explore}"/>
              </MenuItem.Icon>

              <MenuItem Header="{DynamicResource Text.OpenAppDataDir.Config}" Command="{x:Static s:App.OpenAppConfigDirCommand}"/>
              <MenuItem Header="{DynamicResource Text.OpenAppDataDir.Cache}" Command="{x:Static s:App.OpenAppDataDirCommand}"/>
            </MenuItem>
            <MenuItem Header="-"/>
            <MenuItem Header="{DynamicResource Text.SelfUpdate}" Command="{x:Static s:App.CheckForUpdateCommand}" IsVisible="{x:Static s:App.IsCheckForUpdateCommandVisible}">
              <MenuItem.Icon>
                <Path Width="14" Height="14" Data="{StaticResource Icons.SoftwareUpdate}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="-" IsVisible="{x:Static s:App.IsCheckForUpdateCommandVisible}"/>
            <MenuItem Header="{DynamicResource Text.About}" Command="{x:Static s:App.OpenAboutCommand}">
              <MenuItem.Icon>
                <Path Width="14" Height="14" Data="{StaticResource Icons.Info}"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Text.Quit}" Command="{x:Static s:App.QuitCommand}" InputGesture="Ctrl+Q">
              <MenuItem.Icon>
                <Path Width="14" Height="14" Data="{StaticResource Icons.Quit}"/>
              </MenuItem.Icon>
            </MenuItem>
          </MenuFlyout>
        </Button.Flyout>
        <Path Width="12" Height="12" Data="{StaticResource Icons.Menu}"/>
      </Button>

      <!-- Workspace Dropdown Menu -->
      <Button Grid.Column="1" Classes="icon_button" VerticalAlignment="Center" Click="OnOpenWorkspaceMenu" HotKey="{OnPlatform Ctrl+Alt+P, macOS=⌘+Alt+P}">
        <ToolTip.Tip>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Text.Workspace}" FontWeight="Bold" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            <TextBlock Text="{Binding ActiveWorkspace.Name}"/>
            <TextBlock Margin="16,0,0,0"
                       Text="{OnPlatform Ctrl+Alt+P, macOS=⌘+Alt+P}"
                       FontSize="11"
                       Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="14" Height="14"
              Data="{StaticResource Icons.Workspace}"
              Fill="{Binding ActiveWorkspace.Brush}"/>
      </Button>

      <!-- Pages Tabs -->
      <v:LauncherTabBar Grid.Column="2" Height="40" Margin="4,0,16,0" VerticalAlignment="Center"/>

      <!-- Search / Command Palette -->
      <Button Grid.Column="3"
              Classes="title_search"
              Width="300" Height="26"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Click="OnOpenQuickPalette"
              HotKey="{OnPlatform Ctrl+P, macOS=⌘+P}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0" Width="12" Height="12" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG3}"/>
          <TextBlock Grid.Column="1"
                     Margin="8,0"
                     FontSize="12"
                     Foreground="{DynamicResource Brush.FG3}"
                     Text="{DynamicResource Text.Launcher.Search}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
          <Border Grid.Column="2"
                  Padding="5,0"
                  CornerRadius="4"
                  BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
                  VerticalAlignment="Center">
            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG3}" Text="{OnPlatform Ctrl+P, macOS=⌘P}"/>
          </Border>
        </Grid>
      </Button>

      <!-- Update Available Button -->
      <Button Grid.Column="4"
              Classes="icon_button"
              Height="30"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              IsVisible="{Binding NewVersion, Converter={x:Static ObjectConverters.IsNotNull}}"
              Click="OnShowNewVersion"
              ToolTip.Tip="{DynamicResource Text.Launcher.NewVersion}">
        <Path Width="15" Height="15" Data="{StaticResource Icons.SoftwareUpdate}" Fill="{DynamicResource Brush.Accent}"/>
      </Button>

      <!-- Caption Buttons (Windows/Linux) -->
      <Border Grid.Column="5" IsVisible="{Binding #ThisControl.HasRightCaptionButton}">
        <v:CaptionButtons Height="30" VerticalAlignment="Top"/>
      </Border>
    </Grid>

    <!-- Page -->
    <ContentControl Grid.Row="1" Content="{Binding ActivePage}" Background="{DynamicResource Brush.Window}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:LauncherPage">
          <v:LauncherPage/>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Command Palette -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            Background="#CC0A0B0D"
            IsVisible="{Binding CommandPalette, Converter={x:Static ObjectConverters.IsNotNull}}"
            PointerPressed="OnCloseCommandPalette">
      <Border Width="{Binding CommandPalette, Converter={x:Static c:PaletteConverters.ToWidth}}"
              Margin="0,110,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Background="{DynamicResource Brush.Popup}"
              BorderThickness="1" BorderBrush="#24FFFFFF"
              CornerRadius="12"
              BoxShadow="0 30 80 0 #CC000000">
        <Border CornerRadius="12" ClipToBounds="True">
          <ContentControl Margin="{Binding CommandPalette, Converter={x:Static c:PaletteConverters.ToPadding}}" Content="{Binding CommandPalette}">
            <ContentControl.DataTemplates>
              <v:CommandPaletteDataTemplates/>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>
      </Border>
    </Border>
  </Grid>
</v:ChromelessWindow>
