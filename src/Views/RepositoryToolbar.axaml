<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <Grid ColumnDefinitions="*,Auto,*" Margin="14,0">
    <!-- Branch switcher -->
    <Button Grid.Column="0"
            Classes="branch_switcher"
            HorizontalAlignment="Left"
            Click="OpenBranchSwitcher"
            ToolTip.Tip="{DynamicResource Text.Toolbar.SwitchBranch}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse Width="9" Height="9"
                 VerticalAlignment="Center"
                 Fill="{Binding CurrentBranch, Converter={x:Static c:BranchConverters.BranchToLaneBrush}}"/>
        <TextBlock FontWeight="SemiBold"
                   MaxWidth="260"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding CurrentBranch.Name, FallbackValue='--', TargetNullValue='--', Mode=OneWay}"/>
        <TextBlock FontFamily="{DynamicResource Fonts.Monospace}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{Binding CurrentBranch.Ahead.Count, StringFormat='↑{0}', FallbackValue=''}"
                   IsVisible="{Binding CurrentBranch.Ahead, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}, FallbackValue=False}"/>
        <TextBlock FontFamily="{DynamicResource Fonts.Monospace}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{Binding CurrentBranch.Behind.Count, StringFormat='↓{0}', FallbackValue=''}"
                   IsVisible="{Binding CurrentBranch.Behind, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}, FallbackValue=False}"/>
        <Path Width="8" Height="8"
              VerticalAlignment="Center"
              Data="{StaticResource Icons.Down}"
              Fill="{DynamicResource Brush.FG3}"/>
      </StackPanel>
    </Button>

    <!-- Main actions -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
      <Button Classes="tb_action" Tapped="Fetch">
        <ToolTip.Tip>
          <StackPanel Classes="action_tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Tip.Fetch.Title}"/>
            <TextBlock Classes="tip_body" Text="{Binding FetchTip}"/>
            <TextBlock Classes="tip_key" Text="{OnPlatform Ctrl+↓, macOS=⌘↓}"/>
            <TextBlock Classes="tip_key" Text="{DynamicResource Text.CtrlClickTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Text="{DynamicResource Text.Toolbar.Fetch}"/>
        </StackPanel>
      </Button>

      <Button Classes="tb_action" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="action_tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Tip.Pull.Title}"/>
            <TextBlock Classes="tip_body" Text="{Binding PullTip}"/>
            <TextBlock Classes="tip_key" Text="{OnPlatform Ctrl+Shift+↓, macOS=⇧⌘↓}"/>
            <TextBlock Classes="tip_key" Text="{DynamicResource Text.CtrlClickTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Pull}"/>
          <TextBlock Text="{DynamicResource Text.Toolbar.Pull}"/>
          <Border Classes="tb_badge" IsVisible="{Binding CurrentBranch.Behind, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}, FallbackValue=False}">
            <TextBlock Text="{Binding CurrentBranch.Behind.Count, FallbackValue=''}"/>
          </Border>
        </StackPanel>
      </Button>

      <Button Classes="tb_action" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Classes="action_tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Tip.Push.Title}"/>
            <TextBlock Classes="tip_body" Text="{Binding PushTip}"/>
            <TextBlock Classes="tip_key" Text="{OnPlatform Ctrl+Shift+↑, macOS=⇧⌘↑}"/>
            <TextBlock Classes="tip_key" Text="{DynamicResource Text.CtrlClickTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Push}"/>
          <TextBlock Text="{DynamicResource Text.Toolbar.Push}"/>
          <Border Classes="tb_badge" IsVisible="{Binding CurrentBranch.Ahead, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}, FallbackValue=False}">
            <TextBlock Text="{Binding CurrentBranch.Ahead.Count, FallbackValue=''}"/>
          </Border>
        </StackPanel>
      </Button>

      <Rectangle Classes="tb_separator"/>

      <Button Classes="tb_action" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <ToolTip.Tip>
          <StackPanel Classes="action_tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Tip.Branch.Title}"/>
            <TextBlock Classes="tip_body" Text="{Binding BranchTip}"/>
            <TextBlock Classes="tip_key" Text="{OnPlatform Ctrl+B, macOS=⌘B}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Text="{DynamicResource Text.Toolbar.Branch}"/>
        </StackPanel>
      </Button>

      <Button Classes="tb_action" Tapped="StashAll" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="action_tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Tip.Stash.Title}"/>
            <TextBlock Classes="tip_body" Text="{Binding StashTip}"/>
            <TextBlock Classes="tip_key" Text="{DynamicResource Text.CtrlClickTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Stashes.Add}"/>
          <TextBlock Text="{DynamicResource Text.Toolbar.Stash}"/>
        </StackPanel>
      </Button>

      <Button Classes="tb_action"
              Click="PopStash"
              IsVisible="{Binding !IsBare}"
              IsEnabled="{Binding StashesCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"
              ToolTip.ShowOnDisabled="True">
        <ToolTip.Tip>
          <StackPanel Classes="action_tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Tip.Pop.Title}"/>
            <TextBlock Classes="tip_body" Text="{Binding PopTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Stashes}"/>
          <TextBlock Text="{DynamicResource Text.Toolbar.Pop}"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tb_separator"/>

      <Button Classes="tb_action" Click="OpenTerminal">
        <ToolTip.Tip>
          <StackPanel Classes="action_tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Tip.Terminal.Title}"/>
            <TextBlock Classes="tip_body" Text="{Binding TerminalTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Terminal}"/>
          <TextBlock Text="{DynamicResource Text.Toolbar.Terminal}"/>
        </StackPanel>
      </Button>

      <Button Classes="tb_action" Click="OpenMoreMenu" ToolTip.Tip="{DynamicResource Text.Toolbar.More}">
        <Path Width="13" Height="13" Data="{StaticResource Icons.More}"/>
      </Button>
    </StackPanel>

    <!-- Remote status -->
    <StackPanel Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Spacing="6"
                IsVisible="{Binding FetchRemote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource Brush.Added}"/>
      <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG3}" Text="{Binding FetchRemote}"/>
      <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG3}" Text="·"/>
      <v:CommitTimeTextBlock FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.FG3}"
                             ShowAsDateTime="False"
                             UseCompactPeriod="True"
                             Timestamp="{Binding LastFetchTime}"
                             IsVisible="{Binding HasFetched}"/>
      <TextBlock FontSize="12"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG3}"
                 Text="{DynamicResource Text.Toolbar.NeverFetched}"
                 IsVisible="{Binding !HasFetched}"/>
    </StackPanel>

    <!-- Hotkeys -->
    <StackPanel Grid.Column="0" Orientation="Horizontal" IsVisible="False">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>
  </Grid>
</UserControl>
