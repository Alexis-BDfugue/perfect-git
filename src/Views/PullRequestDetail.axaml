<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="800"
             x:Class="SourceGit.Views.PullRequestDetail"
             x:DataType="vm:PullRequestDetail">
  <UserControl.Styles>
    <Style Selector="Border.pr_overview_row">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.pr_overview_row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="Border.pr_overview_row.selected">
      <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
  </UserControl.Styles>

  <TabControl Padding="0,4,0,0">
    <TabItem>
      <TabItem.Header>
        <TextBlock Classes="tab_header" Text="{DynamicResource Text.PullRequest.Inspector}"/>
      </TabItem.Header>

      <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Orientation="Vertical">
            <!-- Header -->
            <Border Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
              <StackPanel Orientation="Vertical" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontFamily="{DynamicResource Fonts.Monospace}"
                             FontSize="11.5"
                             Foreground="{DynamicResource Brush.FG3}"
                             Text="{Binding PullRequest.NumberLabel}"/>
                  <Border Padding="6,0" CornerRadius="8" VerticalAlignment="Center" Background="{Binding PullRequest.State, Converter={x:Static c:PullRequestConverters.ToStateBackground}}">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{Binding PullRequest.State, Converter={x:Static c:PullRequestConverters.ToStateBrush}}"
                               Text="{Binding PullRequest.StateLabel}"/>
                  </Border>
                  <v:LoadingIcon Width="12" Height="12" IsVisible="{Binding IsLoadingInfo}"/>
                </StackPanel>

                <SelectableTextBlock FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding PullRequest.Title}"/>

                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG3}" TextWrapping="Wrap">
                  <Run Text="{Binding PullRequest.Author, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG1}"/>
                  <Run Text="{Binding Dates, Mode=OneWay}"/>
                </TextBlock>

                <Border HorizontalAlignment="Left"
                        Padding="8,3"
                        CornerRadius="6"
                        Background="{DynamicResource Brush.Hover}"
                        IsVisible="{Binding Branches, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <SelectableTextBlock FontFamily="{DynamicResource Fonts.Monospace}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.FG2}"
                                       TextWrapping="Wrap"
                                       Text="{Binding Branches}"/>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Info, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG3}" Text="{Binding Stats}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Added}" Text="{Binding Additions}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Deleted}" Text="{Binding Deletions}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Description: shown in the center -->
            <Border Classes="pr_overview_row"
                    Classes.selected="{Binding IsOverviewShown}"
                    Margin="10,10,10,4"
                    Padding="8,0"
                    Height="30"
                    CornerRadius="6"
                    Cursor="Hand"
                    Tapped="OnShowOverview"
                    IsVisible="{Binding Info, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Path Width="12" Height="12" Fill="{DynamicResource Brush.FG3}" Data="{StaticResource Icons.Detail}"/>
                <TextBlock FontSize="12.5" Text="{DynamicResource Text.PullRequest.Description.Row}"/>
              </StackPanel>
            </Border>

            <!-- Files header -->
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border0}">
              <Grid Margin="18,12,18,8" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Classes="group_header_label"
                           Text="{Binding Changes.Count, Converter={x:Static c:StringConverters.FormatByResourceKey}, ConverterParameter='CommitDetail.Info.Files'}"/>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Added}" Text="{Binding TotalAdded}"/>
                <TextBlock Grid.Column="2" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Deleted}" Text="{Binding TotalDeleted}"/>
                <Border Grid.Column="4" Padding="2" CornerRadius="6" Background="{DynamicResource Brush.Hover}">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="segment" Classes.active="{Binding IsInspectorTreeMode}" Content="{DynamicResource Text.CommitDetail.Info.Tree}" Click="OnTreeMode"/>
                    <Button Classes="segment" Classes.active="{Binding !IsInspectorTreeMode}" Content="{DynamicResource Text.CommitDetail.Info.List}" Click="OnListMode"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Loading / error -->
            <StackPanel Margin="18,4,18,12" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoadingChanges}">
              <v:LoadingIcon Width="14" Height="14"/>
              <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG3}" Text="{DynamicResource Text.PullRequest.Fetching}"/>
            </StackPanel>
            <TextBlock Margin="18,4,18,12"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.FG3}"
                       TextWrapping="Wrap"
                       Text="{Binding ChangesError}"
                       IsVisible="{Binding ChangesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Files -->
            <ListBox Background="Transparent"
                     Margin="10,0,10,8"
                     SelectionMode="Single"
                     ItemsSource="{Binding InspectorRows}"
                     SelectionChanged="OnRowSelectionChanged">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="MinHeight" Value="26"/>
                  <Setter Property="CornerRadius" Value="6"/>
                </Style>
              </ListBox.Styles>

              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>

              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:CommitInspectorRow">
                  <Grid Height="26"
                        Margin="{Binding Indent}"
                        Background="Transparent"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        Tapped="OnRowTapped"
                        ToolTip.Tip="{Binding Change.Path, FallbackValue={x:Null}}">
                    <Path Grid.Column="0"
                          Width="8" Height="8"
                          Margin="11,0,11,0"
                          Classes="inspector_chevron"
                          Classes.collapsed="{Binding !IsExpanded}"
                          Fill="{DynamicResource Brush.FG3}"
                          IsVisible="{Binding IsFolder}"/>
                    <v:ChangeStatusIcon Grid.Column="0"
                                        Width="14" Height="14"
                                        Margin="8,0"
                                        Change="{Binding Change}"
                                        IsVisible="{Binding !IsFolder}"/>
                    <TextBlock Grid.Column="1"
                               Classes="inspector_file"
                               Classes.folder="{Binding IsFolder}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Label}"/>
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Added}" Text="{Binding Added}"/>
                    <TextBlock Grid.Column="3" Margin="6,0,8,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Deleted}" Text="{Binding Deleted}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Margin="18,0,18,16"
                       Foreground="{DynamicResource Brush.FG3}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Text.CommitDetail.Info.OnlyFirstFiles}"
                       IsVisible="{Binding Changes, Converter={x:Static c:ListConverters.IsOnlyTop100Shows}}"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="1" Padding="18,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border0}">
          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button Classes="inspector_action"
                    Content="{DynamicResource Text.PullRequest.Checkout}"
                    IsEnabled="{Binding Info, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Click="OnCheckout"/>
            <Button Classes="inspector_action"
                    Content="{DynamicResource Text.PullRequest.OpenOnGitHub}"
                    Click="OnOpenInBrowser"/>
          </WrapPanel>
        </Border>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
