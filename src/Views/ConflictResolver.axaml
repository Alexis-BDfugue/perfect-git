<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="860"
             x:Class="SourceGit.Views.ConflictResolver"
             x:DataType="vm:ConflictResolver"
             Focusable="True"
             Background="{DynamicResource Brush.Contents}">
  <UserControl.Styles>
    <!-- Buttons of the resolver: outlined by default, .danger (abort), .accent (commit, mark resolved) -->
    <Style Selector="Button.cr_btn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border0}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border x:Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="PART_Hover" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent"/>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.cr_btn:pointerover /template/ Border#PART_Hover">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="Button.cr_btn.danger">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Deleted}"/>
    </Style>
    <Style Selector="Button.cr_btn.danger_fill">
      <Setter Property="Background" Value="{DynamicResource Brush.Deleted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentFG}"/>
    </Style>
    <Style Selector="Button.cr_btn.accent">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentFG}"/>
    </Style>
    <Style Selector="Button.cr_btn.accent:disabled">
      <Setter Property="Background" Value="{DynamicResource Brush.Popup}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG3}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.cr_btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG3}"/>
    </Style>
    <Style Selector="Button.cr_icon">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.cr_icon Path">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
    </Style>

    <!-- Section labels of the side panels -->
    <Style Selector="TextBlock.cr_section">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.3"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG3}"/>
    </Style>

    <!-- Keyboard key caps -->
    <Style Selector="Border.cr_kbd">
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border0}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.cr_kbd > TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Fonts.Monospace}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Conflicted files -->
    <Style Selector="ListBox.cr_files">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="6,0"/>
    </Style>
    <Style Selector="ListBox.cr_files ListBoxItem">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ListBox.cr_files ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ListBox.cr_files ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="ListBox.cr_files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="ListBox.cr_files ListBoxItem:selected TextBlock.cr_name">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- State colors: warning while conflicts are left, green once resolved -->
    <Style Selector="Border.cr_state">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.Warning}" Opacity="0.18"/>
      </Setter>
    </Style>
    <Style Selector="Border.cr_state.ok">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.Added}" Opacity="0.18"/>
      </Setter>
    </Style>
    <Style Selector="Border.cr_state TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
    </Style>
    <Style Selector="Border.cr_state.ok TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Added}"/>
    </Style>
    <Style Selector="Border.cr_banner">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.Warning}" Opacity="0.05"/>
      </Setter>
    </Style>
    <Style Selector="Border.cr_banner.ok">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.Added}" Opacity="0.06"/>
      </Setter>
    </Style>
    <Style Selector="ProgressBar.cr_progress">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
    </Style>
    <Style Selector="ProgressBar.cr_progress.ok">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Added}"/>
    </Style>
    <Style Selector="Ellipse.cr_dot">
      <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
    </Style>
    <Style Selector="Ellipse.cr_dot.ok">
      <Setter Property="Fill" Value="{DynamicResource Brush.Added}"/>
    </Style>
    <Style Selector="TextBlock.cr_status">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
    </Style>
    <Style Selector="TextBlock.cr_status.ok">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Added}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="52,*,28">
    <!-- Banner -->
    <Border Grid.Row="0" Classes="cr_banner" Classes.ok="{Binding IsAllResolved}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
      <Grid Margin="16,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <Border Grid.Column="0" Classes="cr_state" Classes.ok="{Binding IsAllResolved}" Width="26" Height="26" CornerRadius="7" VerticalAlignment="Center">
          <Grid>
            <TextBlock Text="!" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsAllResolved}"/>
            <TextBlock Text="✓" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsAllResolved}"/>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,0,0" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock FontWeight="SemiBold" Text="{Binding Verb}" VerticalAlignment="Center"/>
            <Border Padding="7,1" CornerRadius="5" Background="{Binding Incoming.Background}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="7" Height="7" Fill="{Binding Incoming.Brush}" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11.5" Text="{Binding Incoming.Name}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <TextBlock FontWeight="SemiBold" Text="{Binding Connector}" VerticalAlignment="Center"/>
            <Border Padding="7,1" CornerRadius="5" Background="{Binding Current.Background}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="7" Height="7" Fill="{Binding Current.Brush}" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11.5" Text="{Binding Current.Name}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Subtitle}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="20,0,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressBar Classes="cr_progress" Classes.ok="{Binding IsAllResolved}"
                       Width="120" Height="4" MinHeight="4" MinWidth="0"
                       CornerRadius="2"
                       Minimum="0" Maximum="1"
                       Value="{Binding ProgressRatio, Mode=OneWay}"
                       Background="{DynamicResource Brush.Border0}"
                       VerticalAlignment="Center"/>
          <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11.5" Foreground="{DynamicResource Brush.FG2}" Text="{Binding ProgressLabel}" VerticalAlignment="Center"/>
        </StackPanel>

        <Button Grid.Column="4"
                Classes="cr_btn"
                Margin="0,0,8,0"
                BorderThickness="0"
                FontWeight="Normal"
                Foreground="{DynamicResource Brush.FG2}"
                Click="OnBackToHistory"
                ToolTip.Tip="{DynamicResource Text.ConflictResolver.Back.Tip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{DynamicResource Text.ConflictResolver.Back}"/>
            <Border Classes="cr_kbd" Padding="4,0"><TextBlock Text="Esc" FontSize="10.5" Foreground="{DynamicResource Brush.FG3}"/></Border>
          </StackPanel>
        </Button>

        <Button Grid.Column="5" Classes="cr_btn danger" Margin="0,0,8,0" Content="{Binding AbortLabel}" Click="OnAbort"/>

        <Button Grid.Column="6" Classes="cr_btn accent" Padding="14,7" Click="OnFinish" IsEnabled="{Binding IsAllResolved}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding FinishLabel}"/>
            <TextBlock Text="{OnPlatform Ctrl+↵, macOS=⌘↵}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="260,*,300">
      <!-- Files -->
      <Border Grid.Column="0" Background="{DynamicResource Brush.Window}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border0}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <Grid Grid.Row="0" Margin="14,14,14,8" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="cr_section" Text="{DynamicResource Text.ConflictResolver.ConflictedFiles}"/>
            <TextBlock Grid.Column="1" Classes="cr_section" FontFamily="{DynamicResource Fonts.Monospace}">
              <Run Text="{Binding ResolvedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
            </TextBlock>
          </Grid>

          <ListBox Grid.Row="1"
                   x:Name="FilesList"
                   Classes="cr_files"
                   ItemsSource="{Binding Files}"
                   SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                   SelectionMode="Single"
                   ContextRequested="OnFileContextRequested">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ConflictFile">
                <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding Path}">
                  <Border Grid.Column="0" Classes="cr_state" Classes.ok="{Binding IsResolved}" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center">
                    <Grid>
                      <TextBlock Text="!" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsResolved}"/>
                      <TextBlock Text="✓" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsResolved}"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,8,0" Orientation="Vertical" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Classes="cr_name" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG3}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             FontFamily="{DynamicResource Fonts.Monospace}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Text="{Binding Progress}"
                             Foreground="{DynamicResource Brush.FG2}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="2" Margin="14,18,14,8" ColumnDefinitions="*,Auto" IsVisible="{Binding AutoMergedFiles, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}">
            <TextBlock Grid.Column="0" Classes="cr_section" Text="{DynamicResource Text.ConflictResolver.AutoMerged}"/>
            <TextBlock Grid.Column="1" Classes="cr_section" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding AutoMergedFiles.Count}"/>
          </Grid>

          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="6,0" ItemsSource="{Binding AutoMergedFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:String">
                  <Grid Margin="8,4" ColumnDefinitions="16,*" ToolTip.Tip="{Binding}">
                    <TextBlock Grid.Column="0" Text="✓" FontSize="11" Foreground="{DynamicResource Brush.Added}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Converter={x:Static c:PathConverters.PureFileName}}" Foreground="{DynamicResource Brush.FG2}" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="4" Margin="12" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border0}">
            <StackPanel Orientation="Vertical" Spacing="6">
              <TextBlock FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Text.ConflictResolver.Undo.Title}"/>
              <TextBlock FontSize="11.5" LineHeight="17" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{Binding UndoDescription}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Editor -->
      <Grid Grid.Column="1" RowDefinitions="44,5*,34,4*">
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
          <Grid Margin="16,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding SelectedFile.FolderPrefix, Mode=OneWay, FallbackValue=''}" Foreground="{DynamicResource Brush.FG3}"/><Run Text="{Binding SelectedFile.Name, Mode=OneWay, FallbackValue=''}"/>
            </TextBlock>
            <Border Grid.Column="1" Margin="12,0,0,0" Classes="cr_state" Classes.ok="{Binding IsFileTagResolved}" Padding="7,2" CornerRadius="5" VerticalAlignment="Center"
                    IsVisible="{Binding FileTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding FileTag}"/>
            </Border>

            <TextBlock Grid.Column="3" FontSize="12" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center"
                       Text="{Binding Editor.CurrentRegionLabel, FallbackValue=''}"
                       IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal" Spacing="2" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Button Classes="cr_btn cr_icon" Click="OnPrevConflict" ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.PrevConflict}">
                <Path Data="{StaticResource Icons.Up}"/>
              </Button>
              <Button Classes="cr_btn cr_icon" Click="OnNextConflict" ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.NextConflict}">
                <Path Data="{StaticResource Icons.Down}"/>
              </Button>
            </StackPanel>
            <Rectangle Grid.Column="5" Width="1" Height="18" Margin="12,0" Fill="{DynamicResource Brush.Border0}" VerticalAlignment="Center"
                       IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Grid.Column="6" Classes="cr_btn cr_icon" Click="OnFileMenu" ToolTip.Tip="{DynamicResource Text.ConflictResolver.WholeFile}"
                    IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Path Data="{StaticResource Icons.More}" Width="12" Height="12"/>
            </Button>
          </Grid>
        </Border>

        <!-- Current / Incoming -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid Grid.Column="0" RowDefinitions="34,*">
            <Border Grid.Row="0" Background="{DynamicResource Brush.SubPanel}" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource Brush.Border0}">
              <Grid Margin="14,0" ColumnDefinitions="Auto,Auto,*,Auto">
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Current.Brush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="8,0" FontWeight="SemiBold" Text="{DynamicResource Text.ConflictResolver.Current}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11.5" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Current.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource Brush.FG3}" Text="{Binding Current.LastCommitInfo}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" x:Name="CurrentScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border0}" ScrollChanged="OnSideScrollChanged">
              <v:ConflictPane x:Name="CurrentPane"
                              DataContext="{Binding Editor}"
                              x:DataType="vm:MergeConflictEditor"
                              Rows="{Binding CurrentRows}"
                              CurrentRegion="{Binding CurrentRegion}"/>
            </ScrollViewer>
          </Grid>

          <Grid Grid.Column="1" RowDefinitions="34,*">
            <Border Grid.Row="0" Background="{DynamicResource Brush.SubPanel}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
              <Grid Margin="14,0" ColumnDefinitions="Auto,Auto,*,Auto">
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Incoming.Brush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="8,0" FontWeight="SemiBold" Text="{DynamicResource Text.ConflictResolver.Incoming}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11.5" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Incoming.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource Brush.FG3}" Text="{Binding Incoming.LastCommitInfo}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" x:Name="IncomingScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ScrollChanged="OnSideScrollChanged">
              <v:ConflictPane x:Name="IncomingPane"
                              DataContext="{Binding Editor}"
                              x:DataType="vm:MergeConflictEditor"
                              Rows="{Binding IncomingRows}"
                              CurrentRegion="{Binding CurrentRegion}"/>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- Result -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.SubPanel}" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource Brush.Border0}"
                IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid Margin="14,0" ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{DynamicResource Text.ConflictResolver.Result}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Margin="10,0" FontSize="11.5" Foreground="{DynamicResource Brush.FG3}" Text="{Binding ResultDescription}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="10" Height="3" CornerRadius="2" Background="{Binding Current.Brush}"/>
              <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Current.Name}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="12,0,0,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="10" Height="3" CornerRadius="2" Background="{Binding Incoming.Brush}"/>
              <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Incoming.Name}"/>
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="3" x:Name="ResultScroller" Background="{DynamicResource Brush.TitleBar}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
          <v:ConflictPane x:Name="ResultPane"
                          DataContext="{Binding Editor}"
                          x:DataType="vm:MergeConflictEditor"
                          IsResult="True"
                          Rows="{Binding ResultRows}"
                          CurrentRegion="{Binding CurrentRegion}"/>
        </ScrollViewer>

        <!-- Binary, deleted... conflicts: whole-file choices -->
        <ContentControl Grid.Row="1" Grid.RowSpan="3" Margin="16" Content="{Binding Detail}">
          <ContentControl.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Detail" Converter="{x:Static ObjectConverters.IsNotNull}"/>
              <Binding Path="Editor" Converter="{x:Static ObjectConverters.IsNull}"/>
            </MultiBinding>
          </ContentControl.IsVisible>
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:Conflict">
              <v:Conflict/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- Resolved file -->
        <StackPanel Grid.Row="1" Grid.RowSpan="3" Orientation="Vertical" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding SelectedFile.IsResolved, FallbackValue=False}">
          <Border Classes="cr_state ok" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock FontSize="13" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Center"
                     Text="{Binding SelectedFile.Name, Converter={x:Static c:StringConverters.FormatByResourceKey}, ConverterParameter='ConflictResolver.FileResolved', FallbackValue=''}"/>
        </StackPanel>
      </Grid>

      <!-- Help -->
      <Border Grid.Column="2" Background="{DynamicResource Brush.SubPanel}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Border0}">
        <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="8" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="cr_section" Text="{DynamicResource Text.ConflictResolver.Why}"/>
            <TextBlock FontSize="12.5" LineHeight="19" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{Binding WhyDescription}"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,20,0,0" Orientation="Vertical" Spacing="8">
            <TextBlock Classes="cr_section" Text="{DynamicResource Text.ConflictResolver.Who}"/>
            <ContentControl Content="{Binding Current}"/>
            <ContentControl Content="{Binding Incoming}"/>
          </StackPanel>

          <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Vertical" Spacing="6">
            <TextBlock Classes="cr_section" Text="{DynamicResource Text.ConflictResolver.Shortcuts}"/>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="24,24,24,24">
              <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.ConflictResolver.KeepCurrent}" VerticalAlignment="Center"/>
              <Border Grid.Row="0" Grid.Column="1" Classes="cr_kbd"><TextBlock Text="⌥←"/></Border>
              <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.ConflictResolver.KeepIncoming}" VerticalAlignment="Center"/>
              <Border Grid.Row="1" Grid.Column="1" Classes="cr_kbd"><TextBlock Text="⌥→"/></Border>
              <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.ConflictResolver.KeepBoth}" VerticalAlignment="Center"/>
              <Border Grid.Row="2" Grid.Column="1" Classes="cr_kbd"><TextBlock Text="⌥↓"/></Border>
              <TextBlock Grid.Row="3" Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.MergeConflictEditor.NextConflict}" VerticalAlignment="Center"/>
              <Border Grid.Row="3" Grid.Column="1" Classes="cr_kbd"><TextBlock Text="{OnPlatform Ctrl+↓, macOS=⌘↓}"/></Border>
            </Grid>
          </StackPanel>

          <Border Grid.Row="4" Padding="0,14,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border0}">
            <StackPanel Orientation="Vertical" Spacing="6">
              <TextBlock Classes="cr_section" Text="{DynamicResource Text.ConflictResolver.UnderTheHood}"/>
              <StackPanel Orientation="Vertical" Spacing="2">
                <SelectableTextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11.5" Text="{Binding StartCommand}" TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG3}" Text="{DynamicResource Text.ConflictResolver.StartedBy}"/>
              </StackPanel>
              <StackPanel Orientation="Vertical" Spacing="2" IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                <SelectableTextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11.5" Text="{Binding StageCommand}" TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG3}" Text="{DynamicResource Text.ConflictResolver.MarkRuns}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Button Grid.Row="5"
                  Margin="0,14,0,0"
                  Classes="cr_btn accent"
                  Padding="12,9"
                  HorizontalAlignment="Stretch"
                  Click="OnMarkResolved"
                  IsEnabled="{Binding CanMarkResolved}"
                  IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding MarkResolvedLabel}" TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.TitleBar}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border0}">
      <StackPanel Margin="14,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Ellipse Classes="cr_dot" Classes.ok="{Binding IsAllResolved}" Width="7" Height="7" VerticalAlignment="Center"/>
        <TextBlock Classes="cr_status" Classes.ok="{Binding IsAllResolved}" FontSize="11.5" Text="{Binding StatusText}" VerticalAlignment="Center"/>
        <v:LoadingIcon Width="12" Height="12" Margin="8,0,0,0" IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </Border>

    <!-- Abort confirmation -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Background="#CC0A0B0D" IsVisible="{Binding IsAbortConfirmVisible}">
      <Border Width="440" Margin="0,150,0,0" Padding="22" VerticalAlignment="Top" CornerRadius="12"
              Background="{DynamicResource Brush.Popup}" BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}"
              BoxShadow="0 30 80 0 #CC000000">
        <StackPanel Orientation="Vertical" Spacing="14">
          <Border Width="36" Height="36" CornerRadius="9" HorizontalAlignment="Left">
            <Border.Background>
              <SolidColorBrush Color="{DynamicResource Color.Deleted}" Opacity="0.15"/>
            </Border.Background>
            <TextBlock Text="↺" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Deleted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding AbortTitle}"/>
          <TextBlock FontSize="12.5" LineHeight="19" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{Binding AbortDescription}"/>
          <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11.5" Foreground="{DynamicResource Brush.FG3}" Text="{Binding AbortCommand}"/>
          <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="cr_btn" Padding="14,7" Content="{DynamicResource Text.ConflictResolver.AbortConfirm.Keep}" Click="OnCancelAbort"/>
            <Button Classes="cr_btn danger_fill" Padding="14,7" Content="{Binding AbortLabel}" Click="OnConfirmAbort"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ConflictSide">
      <Border Padding="10" CornerRadius="8" Background="{DynamicResource Brush.Popup}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border0}">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" BorderThickness="1.5" BorderBrush="{Binding Brush}" Padding="2" VerticalAlignment="Top"
                  IsVisible="{Binding LastCommit, Converter={x:Static ObjectConverters.IsNotNull}}">
            <v:Avatar Width="23" Height="23" User="{Binding LastCommit.Author, FallbackValue={x:Null}}"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Vertical" Spacing="3">
            <TextBlock FontWeight="SemiBold" Text="{Binding LastCommit.Subject, FallbackValue=''}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding LastCommit, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.FG3}" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding LastCommit, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Run Text="{Binding LastCommitInfo, Mode=OneWay}"/>
              <Run Text="·"/>
              <Run Text="{Binding LastCommit.SHA, Mode=OneWay, Converter={x:Static c:StringConverters.ToShortSHA}, FallbackValue=''}" FontFamily="{DynamicResource Fonts.Monospace}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center"/>
              <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
