<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.CommitDetail"
             x:DataType="vm:CommitDetail"
             x:Name="ThisControl">
  <TabControl SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}" Padding="0,4,0,0">
    <!-- Information Page -->
    <TabItem>
      <TabItem.Header>
        <Border Background="Transparent" PointerPressed="OnTabHeaderPointerPressed">
          <TextBlock Classes="tab_header" Text="{DynamicResource Text.CommitDetail.Info}"/>
        </Border>
      </TabItem.Header>

      <Grid RowDefinitions="*,Auto" IsVisible="{Binding #ThisControl.IsDetailsPanelExpanded, Mode=OneWay}">
        <ScrollViewer Grid.Row="0"
                      Offset="{Binding ScrollOffset, Mode=TwoWay}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Orientation="Vertical">
            <!-- Header -->
            <Border Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
              <v:CommitBaseInfo UseInspectorLayout="True"
                                Content="{Binding Commit}"
                                FullMessage="{Binding FullMessage}"
                                SignInfo="{Binding SignInfo}"
                                WebLinks="{Binding WebLinks}"/>
            </Border>

            <!-- Files header -->
            <Grid Margin="18,12,18,8" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <TextBlock Grid.Column="0"
                         Classes="group_header_label"
                         Text="{Binding Changes.Count, Converter={x:Static c:StringConverters.FormatByResourceKey}, ConverterParameter='CommitDetail.Info.Files'}"/>
              <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Added}" Text="{Binding TotalAdded}"/>
              <TextBlock Grid.Column="2" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Deleted}" Text="{Binding TotalDeleted}"/>
              <Border Grid.Column="4" Padding="2" CornerRadius="6" Background="{DynamicResource Brush.Hover}">
                <StackPanel Orientation="Horizontal">
                  <Button Classes="segment" Classes.active="{Binding IsInspectorTreeMode}" Content="{DynamicResource Text.CommitDetail.Info.Tree}" Click="OnInspectorTreeMode"/>
                  <Button Classes="segment" Classes.active="{Binding !IsInspectorTreeMode}" Content="{DynamicResource Text.CommitDetail.Info.List}" Click="OnInspectorListMode"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Files -->
            <ListBox Background="Transparent"
                     Margin="10,0,10,8"
                     SelectionMode="Single"
                     ItemsSource="{Binding InspectorRows}"
                     SelectionChanged="OnInspectorSelectionChanged"
                     KeyDown="OnCommitListKeyDown">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="MinHeight" Value="26"/>
                  <Setter Property="CornerRadius" Value="6"/>
                </Style>
              </ListBox.Styles>

              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>

              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:CommitInspectorRow">
                  <Grid Height="26"
                        Margin="{Binding Indent}"
                        Background="Transparent"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        Tapped="OnInspectorRowTapped"
                        ContextRequested="OnInspectorRowContextRequested"
                        ToolTip.Tip="{Binding Change.Path, FallbackValue={x:Null}}">
                    <Path Grid.Column="0"
                          Width="8" Height="8"
                          Margin="11,0,11,0"
                          Classes="inspector_chevron"
                          Classes.collapsed="{Binding !IsExpanded}"
                          Fill="{DynamicResource Brush.FG3}"
                          IsVisible="{Binding IsFolder}"/>
                    <v:ChangeStatusIcon Grid.Column="0"
                                        Width="14" Height="14"
                                        Margin="8,0"
                                        Change="{Binding Change}"
                                        IsVisible="{Binding !IsFolder}"/>
                    <TextBlock Grid.Column="1"
                               Classes="inspector_file"
                               Classes.folder="{Binding IsFolder}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Label}"/>
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Added}" Text="{Binding Added}"/>
                    <TextBlock Grid.Column="3" Margin="6,0,8,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Deleted}" Text="{Binding Deleted}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Only Top100 Tip -->
            <Panel Margin="18,0,18,16" IsVisible="{Binding Changes, Converter={x:Static c:ListConverters.IsOnlyTop100Shows}}">
              <TextBlock Text="{DynamicResource Text.CommitDetail.Info.GotoChangesPage}"
                         Foreground="{DynamicResource Brush.FG3}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding #ThisControl.ShowChangesTab}"/>
              <TextBlock Text="{DynamicResource Text.CommitDetail.Info.OnlyFirstFiles}"
                         Foreground="{DynamicResource Brush.FG3}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding !#ThisControl.ShowChangesTab}"/>
            </Panel>
          </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="1" Padding="18,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border0}">
          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button Classes="inspector_action" Content="{DynamicResource Text.CommitDetail.Action.Checkout}" Click="OnCheckoutCommit"/>
            <Button Classes="inspector_action" Content="{DynamicResource Text.CommitDetail.Action.CherryPick}" Click="OnCherryPickCommit"/>
            <Button Classes="inspector_action" Content="{DynamicResource Text.CommitDetail.Action.Revert}" Click="OnRevertCommit"/>
            <Button Classes="inspector_action" Click="OnMoreCommitActions" ToolTip.Tip="{DynamicResource Text.Toolbar.More}">
              <Path Width="12" Height="12" Data="{StaticResource Icons.More}" Fill="{DynamicResource Brush.FG2}"/>
            </Button>
          </WrapPanel>
        </Border>
      </Grid>
    </TabItem>

    <TabItem IsVisible="{Binding #ThisControl.ShowChangesTab}">
      <TabItem.Header>
        <Border Background="Transparent" PointerPressed="OnTabHeaderPointerPressed">
          <TextBlock Classes="tab_header" Text="{DynamicResource Text.CommitDetail.Changes}"/>
        </Border>
      </TabItem.Header>
      <v:CommitChanges Margin="4,0"
                       IsVisible="{Binding #ThisControl.IsDetailsPanelExpanded, Mode=OneWay}"/>
    </TabItem>

    <TabItem IsVisible="{Binding #ThisControl.ShowChangesTab}">
      <TabItem.Header>
        <Border Background="Transparent" PointerPressed="OnTabHeaderPointerPressed">
          <TextBlock Classes="tab_header" Text="{DynamicResource Text.CommitDetail.Files}"/>
        </Border>
      </TabItem.Header>
      <v:RevisionFiles Margin="4,0"
                       IsVisible="{Binding #ThisControl.IsDetailsPanelExpanded, Mode=OneWay}"/>
    </TabItem>
  </TabControl>
</UserControl>
